{
  "version": 2,
  "buildCommand": "rm -rf frontend/field-collect && cp -r field-collect frontend/field-collect && rm -rf frontend/field-collect/qa frontend/field-collect/supabase",
  "outputDirectory": "frontend",
  "routes": [
    {
      "src": "/field-collect",
      "status": 308,
      "headers": {
        "Location": "/field-collect/"
      }
    },
    {
      "src": "/field-collect/sw.js",
      "headers": {
        "Cache-Control": "no-cache",
        "Service-Worker-Allowed": "/field-collect/"
      },
      "continue": true
    },
    {
      "src": "/data/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
